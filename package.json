{
  "name": "isp-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node --experimental-strip-types scripts/check-production.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:connector": "python3 -m unittest discover -s connector -p \"test_*.py\"",
    "check:production": "node --experimental-strip-types scripts/check-production.mjs --require-live"
  },
  "dependencies": {
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "0.468.0",
    "next": "16.3.5",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
