# Leave blank to show setup guidance. Demo is a separate public route, /demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Required for admin/staff credential provisioning.
# Prefer the current Supabase secret key; legacy projects may use service_role.
SUPABASE_SECRET_KEY=
# Trusted absolute origin; configure separately in staging and production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only: one local test router. Generate the token on the connector host.
MIKROTIK_CONNECTOR_TOKEN_SHA256=
MIKROTIK_ORGANIZATION_ID=

# Server only. One unique router key and SHA256 token hash per router.
# When set, replaces the legacy single-router variables above.
MIKROTIK_ROUTERS_JSON=
